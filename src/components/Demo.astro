<script is:inline>
const base='https://github-profile-card-blue.vercel.app';const form=document.getElementById('card-form');const preview=document.getElementById('card-preview');const code=document.getElementById('markdown-code');const status=document.getElementById('form-status');const error=document.getElementById('preview-error');const copyButton=document.getElementById('copy-btn');const usernameInput=document.getElementById('username');const themeInput=document.getElementById('theme');const allowedThemes=new Set([...themeInput.options].map(option=>option.value));let currentUrl='';let requestId=0;let requestTimer;let expectedUrl='';function makeUrl(){const user=usernameInput.value.trim().replace(/^@/,'');const theme=themeInput.value;if(!/^[a-zA-Z0-9-]{1,39}$/.test(user)||!allowedThemes.has(theme))return null;return `${base}/card/${encodeURIComponent(user)}?theme=${encodeURIComponent(theme)}`}function update(){const url=makeUrl();currentUrl='';copyButton.disabled=true;if(!url){status.textContent='Use a valid GitHub username and theme.';preview.hidden=true;error.hidden=false;return}status.textContent='Loading the real profile card…';error.hidden=true;preview.hidden=false;preview.classList.add('is-loading');const id=++requestId;clearTimeout(requestTimer);expectedUrl=url;preview.src=url;requestTimer=setTimeout(()=>{if(id!==requestId||preview.src!==expectedUrl)return;preview.hidden=true;error.hidden=false;preview.classList.remove('is-loading');status.textContent='The card took too long to load. Try again.'},8000);code.textContent=`![GitHub profile card](${url})`}form.addEventListener('submit',e=>{e.preventDefault();update()});copyButton.addEventListener('click',async()=>{if(!currentUrl)return;try{await navigator.clipboard.writeText(currentUrl);status.textContent='Live card URL copied.'}catch{status.textContent='Copy unavailable — use the Markdown line below.'}});preview.addEventListener('load',()=>{if(preview.src!==expectedUrl)return;clearTimeout(requestTimer);currentUrl=preview.src;copyButton.disabled=false;preview.classList.remove('is-loading');status.textContent='Real profile card ready.'});preview.addEventListener('error',()=>{if(preview.src!==expectedUrl)return;clearTimeout(requestTimer);currentUrl='';copyButton.disabled=true;preview.classList.remove('is-loading');preview.hidden=true;error.hidden=false;status.textContent='We could not load that GitHub profile.'});document.getElementById('retry-btn').addEventListener('click',update);themeInput.value='tokyonight';update();
</script>
