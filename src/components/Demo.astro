<script is:inline>
  (() => {
    const base = "https://github-profile-card-blue.vercel.app";
    const form = document.getElementById("card-form");
    const usernameInput = document.getElementById("username");
    const themeInput = document.getElementById("theme");
    const allowedThemes = new Set(
      [...themeInput.options].map((option) => option.value),
    );
    function createPreview({
      imageId,
      errorId,
      copyId,
      codeId,
      statusId,
      retryId,
      endpoint,
      label,
    }) {
      let image = document.getElementById(imageId);
      const error = document.getElementById(errorId);
      const copy = document.getElementById(copyId);
      const code = document.getElementById(codeId);
      const status = document.getElementById(statusId);
      let generation = 0;
      let timer;
      let currentUrl = "";
      function update() {
        const request = ++generation;
        clearTimeout(timer);
        currentUrl = "";
        copy.disabled = true;
        image.hidden = true;
        image.classList.remove("is-loading");
        image.onload = image.onerror = null;
        image.removeAttribute("src");
        error.hidden = true;
        code.textContent = "";
        const username = usernameInput.value.trim().replace(/^@/, "");
        const theme = themeInput.value;
        if (
          !/^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$/.test(username) ||
          username.includes("--") ||
          !allowedThemes.has(theme)
        ) {
          status.textContent = "Use a valid GitHub username and theme.";
          return;
        }
        const url = `${base}/${endpoint}/${encodeURIComponent(username)}?theme=${encodeURIComponent(theme)}`;
        code.textContent = `![${label}](${url})`;
        status.textContent = `Loading ${label.toLowerCase()}…`;
        image.alt = `${label} for ${username}`;
        image.classList.add("is-loading");
        // Load into a separate image so superseded requests cannot change the UI.
        const pending = new Image();
        function fail(message) {
          if (request !== generation) return;
          clearTimeout(timer);
          generation++;
          image.hidden = true;
          image.classList.remove("is-loading");
          error.hidden = false;
          status.textContent = message;
        }
        pending.onload = () => {
          if (request !== generation) return;
          clearTimeout(timer);
          for (const attribute of image.attributes) {
            if (attribute.name !== "src") {
              pending.setAttribute(attribute.name, attribute.value);
            }
          }
          pending.onload = pending.onerror = null;
          image.replaceWith(pending);
          image = pending;
          image.hidden = false;
          image.classList.remove("is-loading");
          currentUrl = url;
          copy.disabled = false;
          status.textContent = `${label} ready.`;
        };
        pending.onerror = () => fail(`${label} unavailable. Try again.`);
        timer = setTimeout(
          () => fail(`${label} took too long to load. Try again.`),
          10000,
        );
        pending.src = url;
      }
      document.getElementById(retryId).addEventListener("click", update);
      copy.addEventListener("click", async () => {
        if (!currentUrl) return;
        try {
          await navigator.clipboard.writeText(currentUrl);
          status.textContent = `${label} URL copied.`;
        } catch {
          status.textContent =
            "Copy unavailable — use the Markdown line above.";
        }
      });
      return update;
    }
    const updateCard = createPreview({
      imageId: "card-preview",
      errorId: "preview-error",
      copyId: "copy-btn",
      codeId: "markdown-code",
      statusId: "form-status",
      retryId: "retry-btn",
      endpoint: "card",
      label: "GitHub profile card",
    });
    const updateViews = createPreview({
      imageId: "views-preview",
      errorId: "views-error",
      copyId: "views-copy-btn",
      codeId: "views-markdown-code",
      statusId: "views-status",
      retryId: "views-retry-btn",
      endpoint: "profile",
      label: "Profile views",
    });
    themeInput.value = "tokyonight";
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      updateCard();
      updateViews();
    });
    updateCard();
    updateViews();
  })();
</script>
