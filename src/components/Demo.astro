ng:13px;overflow:auto;border-radius:9px;background:var(--pink-soft);color:var(--ink);font-size:11px;white-space:nowrap}.preview-error{display:grid;gap:12px;place-items:center;color:var(--muted);font-size:13px}@media(max-width:760px){.demo{padding:75px 0}.playground{grid-template-columns:1fr;padding:16px}.preview-body{min-height:220px}}</style>
